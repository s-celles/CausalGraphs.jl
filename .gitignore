# Allowlist pattern (gitallow)
*
!*/

# Explicitly allow specific files at root
!.gitignore
!Project.toml
!Manifest.toml
!README.md
!ROADMAP.md
!LICENSE.md
!CHANGELOG.md
!SECURITY.md
!justfile

# Allow source, tests, and docs files
!src/**
!test/**
!docs/Project.toml
!docs/Manifest.toml
!docs/make.jl
!docs/src/**
!.github/**
!ext/**

# Re-ignore generated or build files
docs/build/
*.cov
*.info
*.mem
*.swp
*~
